[user]
	name = pierreozoux
	email = pierre@ozoux.net
[core]
	editor = vim
	autocrlf = input
[init]
	defaultBranch = main
[push]
	default = simple
[pull]
	rebase = true
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	s = status -s
	a = add -A
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true
[include]
	# Machine-specific, not in this repo (e.g. work email, signing key)
	path = ~/.gitconfig.local
